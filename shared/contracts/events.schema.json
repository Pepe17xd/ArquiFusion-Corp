{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arquifusion.local/contracts/events.v1.schema.json",
  "title": "ArquiFusion cross-service event v1",
  "type": "object",
  "required": ["eventId", "eventType", "schemaVersion", "timestamp", "taskId", "executionId", "correlationId", "source", "payload"],
  "properties": {
    "eventId": { "type": "string", "minLength": 1 },
    "eventType": { "type": "string", "enum": ["AgentTaskRequested", "AgentTaskAssigned", "AgentTaskStarted", "AgentTaskCompleted", "AgentTaskFailed", "IntelligenceAnalysisRequested", "IntelligenceAnalysisCompleted", "OperationalAlertCreated", "NotificationRequested"] },
    "schemaVersion": { "const": "1.0" },
    "timestamp": { "type": "string", "format": "date-time" },
    "taskId": { "type": "string", "minLength": 1 },
    "executionId": { "type": "string", "minLength": 1 },
    "correlationId": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "minLength": 1 },
    "payload": { "type": "object" }
  },
  "additionalProperties": false
}
