# Copia este archivo a .env para desarrollo local. No añadas secretos aquí.
# Los proveedores externos permanecen deshabilitados hasta configurarse mediante
# variables protegidas o un gestor de secretos.
STORAGE_MODE=local
AUTH_MODE=local
MACHINES_TABLE=
LEGACY_MACHINES_TABLE=
TENANTS_TABLE=
TASKS_TABLE=
TASK_STATE_MACHINE_ARN=
UPLOADS_BUCKET=
HTTP_API_ID=
COGNITO_ISSUER=
COGNITO_AUDIENCE=
WEB_ORIGIN=http://localhost:5173
AWS_ACCOUNT_ID=
AWS_LAMBDA_ROLE_ARN=
AWS_STEP_FUNCTIONS_ROLE_ARN=
# Optional pre-existing execution-role ARNs per function/domain. When omitted,
# the function uses AWS_LAMBDA_ROLE_ARN (for AWS Academy, usually LabRole).
HEALTH_ROLE_ARN=
TENANT_READ_ROLE_ARN=
TENANT_WRITE_ROLE_ARN=
FLEET_READ_ROLE_ARN=
INGESTION_WRITE_ROLE_ARN=
INTELLIGENCE_READ_ROLE_ARN=
SUPERVISOR_SUBMIT_ROLE_ARN=
SUPERVISOR_READ_ROLE_ARN=
SUPERVISOR_OVERVIEW_ROLE_ARN=
SUPERVISOR_WORKER_ROLE_ARN=
VITE_AUTH_MODE=local
VITE_API_URL=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_DOMAIN=
VITE_COGNITO_REDIRECT_URI=http://localhost:5173/auth/callback
SUPERVISOR_DATA_FILE=
GMAIL_ALERT_RECIPIENT=
GCP_INTELLIGENCE_URL=
